FROM node:22-alpine AS typedoc-builder

RUN apk add --no-cache python3 make g++
RUN npm install -g pnpm@10.33.0

WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY backend/package.json backend/
RUN HUSKY=0 pnpm install --frozen-lockfile --filter sudosos-backend

COPY backend/ backend/

RUN pnpm --filter sudosos-backend typedoc

FROM node:22-alpine AS vitepress-builder

RUN apk add --no-cache python3 make g++
RUN npm install -g pnpm@10.33.0

WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY backend/package.json backend/
RUN HUSKY=0 pnpm install --frozen-lockfile --filter sudosos-backend

COPY backend/docs/ backend/docs/
COPY --from=typedoc-builder /repo/backend/docs/content/typedoc/ backend/docs/content/typedoc/

RUN pnpm --filter sudosos-backend docs:build

FROM caddy:alpine AS final-stage

COPY backend/docs/Caddyfile /etc/caddy/Caddyfile

WORKDIR /srv
COPY --from=vitepress-builder /repo/backend/docs/.vitepress/dist /srv

EXPOSE 80
