FROM node:22-alpine AS typedoc-builder

RUN apk add --no-cache python3 make g++
RUN npm install -g pnpm@10.33.0

WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY backend/package.json backend/
RUN HUSKY=0 pnpm install --frozen-lockfile --filter sudosos-backend

COPY backend/ backend/

RUN pnpm --filter sudosos-backend typedoc

FROM node:22-alpine AS vitepress-builder

RUN apk add --no-cache python3 make g++
RUN npm install -g pnpm@10.33.0

WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY backend/package.json backend/
RUN HUSKY=0 pnpm install --frozen-lockfile --filter sudosos-backend

COPY backend/docs/ backend/docs/
COPY --from=typedoc-builder /repo/backend/docs/content/typedoc/ backend/docs/content/typedoc/

RUN pnpm --filter sudosos-backend docs:build

FROM nginx:stable-alpine AS final-stage

RUN rm /etc/nginx/conf.d/default.conf
COPY backend/docs/nginx.conf /etc/nginx/conf.d/default.conf

WORKDIR /app
COPY --from=vitepress-builder /repo/backend/docs/.vitepress/dist /app

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
