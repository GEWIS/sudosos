{
  "name": "@sudosos/sudosos-frontend-common",
  "version": "1.0.0",
  "description": "Common code components, helper functions, and shared resources for the frontend of the SudoSOS application.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "WATCH=true vite build",
    "common:dev": "yarn dev",
    "test": "echo \"No tests specified\" && exit 0",
    "build": "vite build",
    "common:build": "yarn build",
    "type-check": "vue-tsc --noEmit -p tsconfig.json --composite false",
    "lint": "eslint src",
    "lint-fix": "eslint src --fix"
  },
  "main": "./dist/sudosos-frontend-common.umd.cjs",
  "module": "./dist/sudosos-frontend-common.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/sudosos-frontend-common.js",
      "require": "./dist/sudosos-frontend-common.umd.cjs"
    }
  },
  "files": [
    "src/",
    "dist/",
    ".eslintrc.cjs"
  ],
  "author": "SudoSOS WG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GEWIS/sudosos.git",
    "directory": "frontend/lib/common"
  },
  "bugs": {
    "url": "https://github.com/GEWIS/sudosos/issues"
  },
  "homepage": "https://github.com/GEWIS/sudosos/tree/develop/frontend/lib/common#readme",
  "dependencies": {
    "@gewis/sudosos-client": "workspace:*",
    "axios": "catalog:",
    "jose": "^6.1.3",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "pinia": "catalog:",
    "socket.io-client": "^4.8.1",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@gewis/eslint-config-typescript": "catalog:",
    "@gewis/eslint-config-vue": "catalog:",
    "@gewis/prettier-config": "catalog:",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/lodash": "^4.17.21",
    "@typescript-eslint/parser": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vue-tsc": "catalog:"
  }
}
