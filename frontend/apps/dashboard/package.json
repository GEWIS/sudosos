{
  "name": "sudosos-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "VITE_ENV=prod vite",
    "dev:test": "VITE_ENV=test vite",
    "dev:local": "VITE_ENV=local vite",
    "dashboard:dev": "yarn dev",
    "dashboard:dev:prod": "yarn dev:prod",
    "dashboard:dev:test": "yarn dev:test",
    "dashboard:dev:local": "yarn dev:local",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint src",
    "lint-fix": "eslint src --fix",
    "format": "prettier --ignore-path .gitignore --check .",
    "format-fix": "prettier --ignore-path .gitignore --write ."
  },
  "dependencies": {
    "@gewis/splash": "^2.4.0",
    "@gewis/sudosos-client": "workspace:*",
    "@primeuix/themes": "catalog:",
    "@primevue/core": "^4.5.2",
    "@stripe/stripe-js": "^8.5.3",
    "@sudosos/sudosos-frontend-common": "workspace:^",
    "@sudosos/themes": "workspace:^",
    "@tailwindcss/vite": "catalog:",
    "@vee-validate/rules": "^4.15.1",
    "@vee-validate/yup": "^4.15.1",
    "axios": "catalog:",
    "dinero.js": "^1.9.1",
    "fuse.js": "^7.1.0",
    "lodash": "^4.17.21",
    "marked": "^17.0.1",
    "pinia": "catalog:",
    "primeicons": "catalog:",
    "primevue": "catalog:",
    "sass": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-primeui": "catalog:",
    "vee-validate": "^4.15.1",
    "vue": "catalog:",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.6.3",
    "vue3-pdf-app": "^1.0.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@gewis/eslint-config-typescript": "catalog:",
    "@gewis/eslint-config-vue": "catalog:",
    "@gewis/prettier-config": "catalog:",
    "@intlify/eslint-plugin-vue-i18n": "^4.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/dinero.js": "^1.9.4",
    "@types/lodash": "^4.17.21",
    "@types/node": "^24.10.1",
    "@typescript-eslint/parser": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@tsconfig/node-lts": "^24.0.1",
    "eslint": "catalog:",
    "jsonc-eslint-parser": "^2.4.2",
    "npm-run-all": "^4.1.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-eslint-parser": "catalog:",
    "vue-tsc": "catalog:",
    "yaml-eslint-parser": "^1.3.2"
  }
}
